<Window x:Class="ZoidHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ZoidHub v0.3 ALPHA (By Badger)"
        Width="1200" Height="800"
        MinWidth="700" MinHeight="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style x:Key="ThemedCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="14" Height="14" CornerRadius="3"
                                    Background="#2A2A2A" BorderBrush="#555555" BorderThickness="1"
                                    Margin="0,0,6,0">
                                <Path x:Name="CheckMark" Data="M 1,4 L 4,7.5 L 9,1" Stroke="#E0A030"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#E0A030" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#EEEEEE" />
                            </Trigger>
                            <!-- A custom ControlTemplate fully replaces the default chrome, so
                                 WPF's usual automatic disabled-dimming doesn't apply here on its
                                 own - without this, IsEnabled="False" blocks the click but looks
                                 identical to enabled, which isn't actually "greyed out". -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#555555" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#3A3A3A" />
                                <Setter TargetName="Box" Property="Background" Value="#202020" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemedProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="#E0A030" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}">
                            <Grid>
                                <Rectangle x:Name="PART_Track" Fill="Transparent" />
                                <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="True">
                                    <Rectangle Fill="{TemplateBinding Foreground}" RadiusX="4" RadiusY="4" />
                                </Grid>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="MainCard" Background="#E6161616" CornerRadius="10" BorderBrush="#404040" BorderThickness="1">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ZOIDHUB" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="By Badger" FontSize="10" FontWeight="Bold" Foreground="#E0A030"
                                   VerticalAlignment="Center" Margin="8,3,0,0" />
                        <!-- Deliberately more visible than the dim version-tag convention used
                             once an app graduates past its earliest testing stage - ZoidHub is
                             heading toward wider community testing and should read as clearly
                             early/rough to anyone trying it, not just carry a quiet version number. -->
                        <Border Background="#3D2F12" BorderBrush="#E0A030" BorderThickness="1" CornerRadius="4"
                                Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionTag" Text="v0.3 ALPHA" FontSize="10" FontWeight="Bold"
                                       Foreground="#E0A030" />
                        </Border>
                    </StackPanel>

                    <!-- Hidden once the bridge mod is detected installed -->
                    <Button Grid.Column="1" x:Name="InstallBridgeButton" Content="Install Live Position Mod"
                            Style="{StaticResource ToolButton}" Background="#1F2E3D" Foreground="#5CA0E0"
                            BorderBrush="#5CA0E0" BorderThickness="1" Margin="0,0,16,0" Visibility="Collapsed"
                            Click="InstallBridgeButton_Click"
                            ToolTip="Installs the ZoidHubBridge mod into your Zomboid mods folder - you still need to enable it in-game (Mods menu) once." />

                    <CheckBox Grid.Column="2" x:Name="LivePositionCheckBox" Content="Live Position"
                              Style="{StaticResource ThemedCheckBox}" VerticalAlignment="Center"
                              Margin="0,0,16,0" IsEnabled="False" Checked="LivePosition_Changed" Unchecked="LivePosition_Changed"
                              ToolTip="Show your current in-game position on the map. Requires the ZoidHubBridge mod installed and enabled in-game." />

                    <!-- Hidden until UpdateCheckService reports a newer release; opens the GitHub release page. -->
                    <Button Grid.Column="3" x:Name="UpdateAvailableButton" Content="Update Available"
                            Style="{StaticResource ToolButton}" Background="#3D2F12" Foreground="#E0A030"
                            BorderBrush="#E0A030" BorderThickness="1" Margin="0,0,16,0" Visibility="Collapsed"
                            Click="UpdateAvailableButton_Click" ToolTip="A newer version of ZoidHub is on GitHub - click to open the release page" />

                    <Button Grid.Column="4" Style="{StaticResource TitleBarButton}" Content="&#8862;" Click="Fullscreen_Click" FontSize="12" ToolTip="Toggle fullscreen" />
                    <Button Grid.Column="5" Style="{StaticResource TitleBarButton}" Content="&#8212;" Click="Minimize_Click" ToolTip="Minimize" />
                    <Button Grid.Column="6" Style="{StaticResource TitleBarButton}" Content="&#10005;" Click="Close_Click" Margin="0" ToolTip="Close" />
                </Grid>

                <!-- Map -->
                <Border Grid.Row="1" Background="#101010" CornerRadius="8" ClipToBounds="True">
                    <wv2:WebView2 x:Name="MapWebView" />
                </Border>

                <!-- Bottom render-progress bar: obvious, not something you'd miss, since the first
                     launch on a fresh machine can take a while before the map is usable. -->
                <Border x:Name="RenderStatusBar" Grid.Row="2" Margin="0,10,0,0" Padding="12,10"
                        Background="#242424" BorderBrush="#404040" BorderThickness="1" CornerRadius="6"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- MaxWidth+Wrap rather than pure Auto - a long message (e.g. the
                             disk-space warning) would otherwise keep stretching this column and
                             push the speed/location buttons on the right past the window's edge
                             instead of wrapping to a second line. -->
                        <TextBlock Grid.Column="0" x:Name="RenderStatusTitle" Text="Rendering World - This may take some time"
                                   FontWeight="Bold" FontSize="12" Foreground="#E0A030" VerticalAlignment="Center"
                                   Margin="0,0,14,0" MaxWidth="320" TextWrapping="Wrap" />
                        <ProgressBar Grid.Column="1" x:Name="RenderProgressBar" Style="{StaticResource ThemedProgressBar}"
                                     VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0" />
                        <TextBlock Grid.Column="2" x:Name="RenderStatusDetail" Text="" FontSize="11" Foreground="#AAAAAA"
                                   VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="60" TextAlignment="Right" />
                        <!-- Render speed: trades CPU load for render time. Defaults to Light so a
                             stranger's machine isn't pegged without them choosing that. Chosen here,
                             then physically started via StartRenderButton below - a first-ever render
                             can run for hours of real CPU load, so it shouldn't just begin on its own
                             the moment the game install is found. Still changeable mid-render (kept
                             deliberately - MapRenderService.EnsureUnpackedAsync's atomic staging move
                             is what actually guards against an interrupted unpack now, not avoiding
                             the switch in the first place). -->
                        <Button Grid.Column="3" x:Name="SpeedLightButton" Content="Light (less CPU)"
                                Style="{StaticResource ToolButton}" BorderThickness="1" BorderBrush="#404040"
                                Margin="14,0,0,0" Click="SpeedMode_Click"
                                ToolTip="Use fewer CPU cores to render - slower, but leaves your machine free for everything else" />
                        <Button Grid.Column="4" x:Name="SpeedFastButton" Content="Fast (more CPU)"
                                Style="{StaticResource ToolButton}" BorderThickness="1" BorderBrush="#404040"
                                Margin="6,0,0,0" Click="SpeedMode_Click"
                                ToolTip="Use most CPU cores to render - faster, but heavier load while it's running" />
                        <Button Grid.Column="5" x:Name="StartRenderButton" Content="Start Rendering"
                                Style="{StaticResource ToolButton}" Background="#3D2F12" Foreground="#E0A030"
                                BorderThickness="1" BorderBrush="#E0A030" Margin="10,0,0,0" Click="StartRenderButton_Click"
                                ToolTip="Begin the one-time map render using the speed selected above" />
                        <!-- A full render needs ~150-250GB - not every OS drive has (or will ever
                             have) that much room, so this lets someone point map data at a
                             different drive/folder instead of being stuck. Always available
                             alongside the other render controls, not just after the disk-space
                             check fails, so it can be used proactively too. -->
                        <Button Grid.Column="6" x:Name="ChooseLocationButton" Content="Change Location..."
                                Style="{StaticResource ToolButton}" BorderThickness="1" BorderBrush="#404040"
                                Margin="6,0,0,0" Click="ChooseLocationButton_Click"
                                ToolTip="Pick a different drive/folder to store the rendered map (needs ~150-250 GB free)" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Resize grip: WindowStyle="None" + AllowsTransparency="True" (needed for the rounded-
             corner card look) means the OS doesn't give this window resizable edges/corners for
             free, so this drives it manually via WM_SYSCOMMAND/SC_SIZE_BOTTOMRIGHT, same pattern
             as PalHub/TruckHub. Sits in the outer Grid (not inside MainCard's own row layout) so
             it stays anchored to the true bottom-right corner regardless of RenderStatusBar's
             collapsed/visible state.
             Unlike PalHub/TruckHub (which have a permanent bottom status-bar row to place the
             grip in), ZoidHub's map fills nearly the whole card whenever the render bar is
             collapsed. WebView2 is a real child HWND, not just a WPF-painted layer - if this grip
             visually overlapped its rectangle, WPF z-order wouldn't matter and clicks would go to
             the map underneath instead. Sized/margined to stay inside the card's 1px border + 12px
             inner Grid margin (13px total), which is genuinely outside WebView2's own rect. -->
        <Path Width="10" Height="10" Margin="0,0,2,2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Cursor="SizeNWSE" Fill="#555555"
              Data="M 10,0 L 10,10 L 0,10 Z"
              PreviewMouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" />
    </Grid>
</Window>
